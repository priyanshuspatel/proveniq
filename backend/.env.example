# Copy to backend/.env. No secrets belong in this file.
# APP_ENV is development, test, or production. Production refuses a wildcard CORS origin.
APP_ENV=development
# Leave DATABASE_URL unset for local SQLite. postgresql:// is refused until a migration exists.
DATABASE_PATH=./data/licensetrail.db
# DATABASE_URL=sqlite:///./data/licensetrail.db
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_HEALTH_TIMEOUT_SECONDS=3
OLLAMA_MAX_RESPONSE_BYTES=1048576
# Optional credential for an actual private authentication proxy. It does not secure a public Ollama endpoint. Never commit a real key.
# OLLAMA_API_KEY=
REQUEST_TIMEOUT_SECONDS=150
# HTTP body and model response limits. The license text contract remains 200,000 characters.
MAX_REQUEST_BODY_BYTES=2097152
OLLAMA_MAX_RESPONSE_BYTES=1048576
MAX_REQUEST_BODY_BYTES=2097152
